{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["./contracts", "./deploy", "./test", "./hardhat.config.ts"],
  "files": ["./hardhat.config.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "cache", "typechain-types"]
}
